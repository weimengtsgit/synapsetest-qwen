# AI服务环境变量配置示例
# 复制此文件为 .env 并根据实际情况修改配置值

# ============ 缓存配置 ============
# Redis开关: true=使用Redis分布式缓存, false=使用内存缓存(默认)
ENABLE_REDIS=false

# Redis连接配置 (仅当ENABLE_REDIS=true时需要)
REDIS_HOST=localhost
REDIS_PORT=6379
# REDIS_PASSWORD=your_password_here
REDIS_DB=0

# 缓存配置
# 缓存过期时间(秒), 默认5分钟
CACHE_TTL=300
# 内存缓存最大条目数
CACHE_MAX_SIZE=1000

# ============ 数据库配置 ============
# MySQL配置 (如果需要直接访问后端数据库)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=synapsetest123
MYSQL_DATABASE=synapsetest

# ============ LLM配置 ============
# LLM提供商: mock(模拟), local(本地模型), api(远程API)
LLM_PROVIDER=mock

# 本地模型配置 (当LLM_PROVIDER=local时)
LOCAL_MODEL_PATH=/path/to/qwen-7b-chat
USE_GPU=false
MAX_GPU_MEMORY=16GB
MAX_TOKENS=2048
TEMPERATURE=0.7

# API模型配置 (当LLM_PROVIDER=api时)
# LLM_API_KEY=your_api_key_here
# LLM_API_BASE=https://api.openai.com/v1

# ============ 向量数据库配置 ============
# Qdrant配置 (用于语义搜索和RAG)
QDRANT_HOST=localhost
QDRANT_PORT=6333
# QDRANT_API_KEY=your_api_key_here

# Milvus配置 (备选向量数据库)
# MILVUS_HOST=localhost
# MILVUS_PORT=19530

# ============ 应用配置 ============
# 应用运行端口
APP_HOST=0.0.0.0
APP_PORT=8080

# 调试模式
DEBUG=false
LOG_LEVEL=INFO

# CORS配置
CORS_ORIGINS=*

# ============ AI模型配置 ============
# 语义相似度阈值 (0-1)
SIMILARITY_THRESHOLD=0.85

# ============ 其他配置 ============
# 数据库类型
DATABASE_TYPE=mysql
MYSQL_URI=mysql://root:synapsetest123@localhost:3306/synapsetest
VECTOR_DB_TYPE=qdrant
QDRANT_GRPC_PORT=6334
QDRANT_MODE=server
